<?xml version="1.0" encoding="utf-8"?>
<!-- Zayaan Authenticator manages zero-knowledge encrypted backups itself. Exclude all local vault files from Android Auto Backup. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
